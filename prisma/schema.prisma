// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Product {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  name          String
  description   String?
  price         Int 
  status        String   @default("DRAFT")
  tags          String[]
  imageUrl      String?
  artisanNotes  String?
  category      String?
}

model ArtisanProfile {
  id           String    @id @default("main_artisan")
  name         String?   // Make name optional initially
  bio          String?   // Make bio optional initially
  profileImage String?   // NEW: Add a field for a profile picture
  storyNotes   String?   // NEW: Field to store the artisan's raw story
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}